rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    // Returns true if the request is from a signed-in user.
    function isAuth() {
      return request.auth != null;
    }

    // Returns true if the signed-in user's uid matches the given uid.
    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Returns true if the signed-in user is a member of the given circle.
    function isCircleMember(circleId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    // Returns true if the signed-in user is the admin of the given circle.
    function isCircleAdmin(circleId) {
      return isAuth() &&
        get(/databases/$(database)/documents/circles/$(circleId)).data.adminUid == request.auth.uid;
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    // Users can only read and write their own document.

    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid);
      allow update: if isUser(uid);
      allow delete: if false;
    }

    // ── Circles ────────────────────────────────────────────────────────────────
    // Any authenticated user can create a circle.
    // Only members can read a circle.
    // Only the admin can update or delete a circle.

    match /circles/{circleId} {
      allow read: if isCircleMember(circleId);
      allow create: if isAuth();
      allow update: if isCircleAdmin(circleId);
      allow delete: if false;

      // ── Members sub-collection ─────────────────────────────────────────────
      // Members can read the members list.
      // Only the circle admin can add or update members.
      // Cloud Functions can write freely (service account bypasses rules).

      match /members/{uid} {
        allow read: if isCircleMember(circleId);
        allow create: if isCircleAdmin(circleId);
        allow update: if isCircleAdmin(circleId);
        allow delete: if false;
      }

      // ── Transactions sub-collection ────────────────────────────────────────
      // Members can READ all transactions (shared ledger).
      // WRITES are restricted to Cloud Functions only (service account).
      // Client-side writes are blocked in production.

      match /transactions/{txId} {
        allow read: if isCircleMember(circleId);
        allow write: if false; // Cloud Functions only
      }

      // ── Rotation slots sub-collection ──────────────────────────────────────
      // Members can read rotation slots.
      // Writes are Cloud Functions only.

      match /rotationSlots/{slotId} {
        allow read: if isCircleMember(circleId);
        allow create: if isCircleAdmin(circleId); // initial creation allowed
        allow update: if false; // Cloud Functions only
        allow delete: if false;
      }
    }

    // ── AI Tips ────────────────────────────────────────────────────────────────
    // Users can only read their own tips.
    // Tips are written by the Flutter app (via AiAdvisoryRepository) on behalf
    // of the authenticated user, and can be dismissed (update wasDismissed).

    match /aiTips/{tipId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wasDismissed']);
      allow delete: if false;
    }

    // ── Deny everything else ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
