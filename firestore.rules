rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isCircleMember(circleId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    function isCircleAdmin(circleId) {
      return isAuth() &&
        get(/databases/$(database)/documents/circles/$(circleId)).data.adminUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'createdAt', 'isVerified',
          'hasLinkedCard', 'canReceivePayouts'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.isVerified == false
        && request.resource.data.hasLinkedCard == false
        && request.resource.data.canReceivePayouts == false;
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    match /circles/{circleId} {
      allow read: if isCircleMember(circleId);
      // Circle creation and all financial or membership mutations are server-only.
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if isCircleMember(circleId);
        allow create, update, delete: if false;
      }

      match /transactions/{txId} {
        allow read: if isCircleMember(circleId);
        allow write: if false;
      }

      match /rotationSlots/{slotId} {
        allow read: if isCircleMember(circleId);
        allow write: if false;
      }

      match /paymentAttempts/{attemptId} {
        allow read, write: if false;
      }
    }

    match /aiTips/{tipId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wasDismissed']);
      allow delete: if false;
    }

    match /aiUsage/{uid} {
      allow read, write: if false;
    }

    match /users/{uid}/private/{docId} {
      allow read, write: if false;
    }

    match /users/{uid}/paymentSetups/{setupId} {
      allow read, write: if false;
    }

    match /paystackWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

